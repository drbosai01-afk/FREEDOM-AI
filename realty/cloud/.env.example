# Development only: use synthetic test data.
ENVIRONMENT=development
DATABASE_URL=sqlite:///./realty.db
JWT_SECRET=GENERATE_RANDOM_SECRET_USING_SECRETS_TOKEN_URLSAFE_48

# Production: set ENVIRONMENT=production and the following via Vercel encrypted env vars.
# Do not place real values in this file or GitHub.
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/DB?sslmode=require
# JWT_SECRET=<48-or-more-random-characters>
# PUBLIC_BASE_URL=https://api.example.com
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=<smtp-login>
# SMTP_PASSWORD=<smtp-app-secret>
# SMTP_FROM=noreply@example.com
# Run first: ENVIRONMENT=production python -m alembic upgrade head
# Then deploy, check GET /api/health; enable client only after green checks.
# Keep ALLOW_CATALOG_IMPORT unset until a verified source backup and dry run.
