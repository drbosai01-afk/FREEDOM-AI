# Local development only. Replace all placeholders for production.
ENVIRONMENT=development
DATABASE_URL=sqlite:///./leads.sqlite
JWT_SECRET=GENERATE_WITH_python_-c_"import_secrets;print(secrets.token_urlsafe(48))"
PUBLIC_BASE_URL=http://127.0.0.1:8000
# Production: PostgreSQL, HTTPS, unique JWT_SECRET, a verified SMTP sender
# ENVIRONMENT=production
# DATABASE_URL=postgresql+psycopg://user:password@host:5432/leads?sslmode=require
# PUBLIC_BASE_URL=https://your-domain.example
# SMTP_HOST=smtp.your-domain.example
# SMTP_PORT=587
# SMTP_USER=mailbox@your-domain.example
# SMTP_PASSWORD=APP_PASSWORD
# SMTP_FROM=mailbox@your-domain.example
# TELEGRAM_BOT_TOKEN=BOT_TOKEN
# TELEGRAM_CHAT_ID=AUTHORIZED_CHAT_ID
# Required before enabling production public forms:
# PRIVACY_POLICY_URL=https://your-domain.example/privacy
